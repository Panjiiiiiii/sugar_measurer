generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id          String        @id @default(uuid())
  name        String
  password    String
  role        role
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  location_id String
  email       String        @unique
  logTransfer logTransfer[]
  location    location      @relation(fields: [location_id], references: [id])
}

model owner {
  id             String         @id @default(uuid())
  name           String
  account_number String         @unique
  ownership_type ownership_type
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  trucks         truck[]
}

model location {
  id              String        @id @default(uuid())
  name            String
  sugar_price     Int
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  account_balance Int           @default(0)
  account_number  String        @default("0000000000")
  logTransfer     logTransfer[]
  transactions    transaction[]
  users           user[]
}

model truck {
  id            String        @id @default(uuid())
  name          String        @default("Unnamed Truck")
  license_plate String        @unique
  owner_id      String
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  truck_type    String?
  transactions  transaction[]
  owner         owner         @relation(fields: [owner_id], references: [id], onDelete: Cascade)
}

model transaction {
  id               String      @id @default(uuid())
  transaction_date DateTime
  truck_id         String
  location_id      String
  bruto_weight     Int
  tarra_weight     Int
  netto_weight     Int
  total_price      Int
  bukti_transfer   String
  status           status_paid @default(unpaid)
  loading_in       DateTime
  loading_out      DateTime
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt
  location         location    @relation(fields: [location_id], references: [id])
  truck            truck       @relation(fields: [truck_id], references: [id], onDelete: Cascade)
}

model logTransfer {
  id              String   @id @default(uuid())
  user_id         String
  location_id     String
  bukti_transfer  String
  transfer_amount Int
  created_at      DateTime @default(now())
  location        location @relation(fields: [location_id], references: [id])
  user            user     @relation(fields: [user_id], references: [id])
}

enum role {
  branch
  master
  finance
}

enum ownership_type {
  farmer
  private
}

enum status_paid {
  paid
  unpaid
}

enum truck_type {
  engkel
  double
}
